# ---------------------------------------------------------------------------
# NAP frontend runtime configuration
# Copy to `.env` and adjust as needed. `.env` is gitignored.
#
# Backend is the Railway-deployed Spring Boot service.
# Postgres is NOT reachable from the browser -- the backend owns the DB
# connection and exposes it over HTTP only. Never put a database URL here.
# ---------------------------------------------------------------------------

# Base URL that `apiUrl()` in src/lib/apiUrl.ts resolves backend paths against.
#
# Production is same-origin behind a reverse proxy that forwards /api to the
# backend, so a relative "/api" is correct here and needs no CORS.
#
# If you ever need to call an absolute origin instead, it MUST include the
# context path: "https://host/api". A bare origin such as "https://host" will
# resolve requests to /v1/... instead of /api/v1/... and the backend replies
# "500 No static resource". apiUrl() appends "/api" for you when it is missing,
# but be explicit so the intent is obvious.
VITE_API_BASE_URL="/api"

# Target for the `/api` dev proxy in vite.config.ts. This is the absolute host
# the local Vite server forwards to; it is unrelated to VITE_API_BASE_URL.
# Only change this to point at a locally running backend, e.g. http://localhost:8080
NAP_API_TARGET="https://backend-production-b8c2b.up.railway.app"

# Absolute base for the Nexus Admissions Dashboard (NAD) API. The application
# form's course selection reads the programme catalogue that the NAD publishes
# (the programmes are stored in the NAD database, not the NAP database). There
# is no same-origin proxy for the NAD, so this must be an absolute origin. Its
# public endpoints allow any origin, so no CORS change is required here.
VITE_NAD_API_BASE_URL="https://admissions-backend-production-0985.up.railway.app"