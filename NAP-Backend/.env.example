# Railway deployment profile for NAP-Backend (Spring Boot).
# Copy to .env and fill in values, or set these as Railway service variables.

# Tenancy
# ---------------- Tenant resolved from subdomains of this apex host, e.g.
#                 muk.portal.example.com resolves tenant code "muk". Empty disables
#                 subdomain routing; requests fall back to the default tenant.
TENANT_BASE_DOMAIN=
# ---------------- Tenant used when no host mapping applies. Empty falls back to
#                 the demo tenant (id 1) seeded in data.sql.
TENANT_DEFAULT_CODE=demo
# ---------------- Shared secret that lets the ML service select a tenant with an
#                 X-Tenant header (it sends this as X-Internal-Token). When empty,
#                 X-Tenant is ignored and every request resolves by host, so a
#                 public client cannot read another university's content by
#                 guessing its code. Must match INTERNAL_API_TOKEN on NAP-ML-Service.
INTERNAL_API_TOKEN=change-me

# ML service
ML_SERVICE_BASE_URL=http://backend.railway.internal:8080
ML_SERVICE_CONNECT_TIMEOUT=5000
ML_SERVICE_READ_TIMEOUT=120000
# Must match ML_ADMIN_TOKEN on NAP-ML-Service.
ML_SERVICE_ADMIN_TOKEN=change-me

# Authentication
JWT_SECRET=change-me
JWT_EXPIRATION_HOURS=24

# Email (EmailJS) - used for OTP codes and contact form mail.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_OTP_TEMPLATE_ID=template_rb2h0rh
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
MAIL_FROM=waluube69alvin@gmail.com
CONTACT_MAIL_TO=waluube69alvin@gmail.com

# Development-only: set true to echo the generated OTP in the response so it can
# be read without an inbox. Never enable on a deployed environment.
NAP_OTP_EXPOSE_CODE=false