# Railway deployment profile for NAP-ML-Service.
# Copy to .env and fill in values, or set these as Railway service variables.

# Base URL of the NAP Spring backend that serves the CMS content APIs.
# Local development:
NAP_BASE_URL=http://localhost:8080
# Railway (private networking, same project):
# NAP_BASE_URL=http://backend.railway.internal:8080

# Embedding model identifier.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Retrieval tuning.
CHUNK_SIZE=1600
CHUNK_OVERLAP=160
TOP_K_DEFAULT=5
ANSWER_CHUNK_LIMIT=1200

# Display name used in generated answers.
PORTAL_NAME=Nexus University