# Railway deployment profile for NAP-ML-Service.
# Copy to .env and fill in values, or set these as Railway service variables.

# Base URL of the NAP Spring backend that serves the CMS content APIs.
# Local development:
NAP_BASE_URL=http://localhost:8080
# Railway (private networking, same project):
# NAP_BASE_URL=http://backend.railway.internal:8080

# Embedding model identifier.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Retrieval tuning.
CHUNK_SIZE=1600
CHUNK_OVERLAP=160
TOP_K_DEFAULT=5
ANSWER_CHUNK_LIMIT=1200

# Display name used in generated answers.
PORTAL_NAME=Nexus University

# Optional contact overrides for "who can I contact?" answers. Leave these unset
# to use the CMS values (footer_email / footer_phone / footer_address from
# /api/v1/content/site-settings) with the front-end fallbacks. Set them only if
# contact details are kept out of the database.
# CONTACT_EMAIL=admissions@example.edu
# CONTACT_PHONE=+256 700 000 000
# CONTACT_WHATSAPP=+256 700 000 000
# CONTACT_ADDRESS=Plot 7, Nakawa Road, Kampala, Uganda
# CONTACT_HOURS=Monday-Friday, 8:00 AM - 5:00 PM

# Where the built index is written. Point this at a mounted volume so the
# index survives restarts and redeploys; without one the container starts
# empty on every deploy and rebuilds at startup.
# Railway: create a volume mounted at /data and use ML_DATA_DIR=/data
ML_DATA_DIR=./data

# Build the index at startup when none exists (recommended with a volume).
AUTO_TRAIN_ON_STARTUP=true
AUTO_TRAIN_ATTEMPTS=3
AUTO_TRAIN_BACKOFF_SECONDS=10

# Shared secret required by POST /api/train and GET /api/sources.
# Required in production: the endpoints fail closed with 503 when it is unset.
# Must match ML_SERVICE_ADMIN_TOKEN on the NAP-Backend service.
ML_ADMIN_TOKEN=change-me